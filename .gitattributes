# 줄바꿈은 저장소 안에서 LF 로 통일
* text=auto

# Unity YAML
*.unity      text eol=lf
*.prefab     text eol=lf
*.mat        text eol=lf
*.meta       text eol=lf
*.anim       text eol=lf
*.controller text eol=lf
*.cs         text diff=csharp
*.shader     text
*.cginc      text

